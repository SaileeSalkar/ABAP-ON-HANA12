{
  use create;
  use update;
  use delete;

  use association _Booking { create; }
}

define behavior for ZCDS17_C_M_PR_BOOKING //alias Booking
{
  use update;
  use delete;

  use association _Travel;
 // use association _BookSupplemnt { create; }
