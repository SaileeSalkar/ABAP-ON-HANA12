define behavior for ZCDS13_C_M_TRAVEL alias Travel
persistent table /dmo/travel
lock master
//authorization master ( instance )
etag master lastchangedat
{
  create ( authorization : global );
  update;
  delete;
 // field ( readonly ) travel_id;
 field ( mandatory )  agency_id,customer_id;
  association _Booking { create; }
}

define behavior for ZCDS14_C_M_BOOKING alias Booking
persistent table /DMO/booking
lock dependent by _Travel
//authorization dependent by _Travel
etag master lastchangedat
{
  update;
  delete;
  field ( readonly:update ) travel_id, booking_id;
  association _Travel;
  association _BookSupplemnt { create; }
}

define behavior for ZCDS15_C_M_BOOKSUPP alias BookSupplment
persistent table /DMO/BOOKSUPPL_M
lock dependent by _Travel
//authorization dependent by _Travel
etag master lastchangedat
{
  update;
  delete;
  field ( readonly:update ) travel_id, booking_id, booking_supplement_id;
  association _Travel;
  association _Booking;
}